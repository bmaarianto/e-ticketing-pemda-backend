# Salin file ini jadi .env, terus isi sesuai environment lokal lu

# Koneksi ke PostgreSQL (kalau pake docker-compose yang disediain, ini udah cocok)
DATABASE_URL="postgresql://helpdesk_user:helpdesk_pass@localhost:5432/helpdesk_db?schema=public"

# Port backend jalan
PORT=4000

# Buat CORS, samain sama port frontend Next.js
FRONTEND_URL="http://localhost:3000"

# Dipake pas fase Auth nanti buat sign JWT — ganti dengan random string yang panjang
JWT_SECRET="ganti_dengan_secret_yang_aman"
JWT_EXPIRES_IN="1d"
